{
  "headers": [
    {
      "source": "/(index.html|sw.js|manifest.webmanifest|registerSW.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/workshops/save",
      "destination": "/api/save-workshop"
    },
    {
      "source": "/api/auth/forgot-password",
      "destination": "/api/forgot-password"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/reset-password"
    },
    {
      "source": "/api/forgot-password",
      "destination": "/api/forgot-password"
    },
    {
      "source": "/api/reset-password",
      "destination": "/api/reset-password"
    },
    {
      "source": "/api/:match*",
      "destination": "https://workshop-registration-system-9fbd.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
