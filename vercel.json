{
  "rewrites": [
    {
      "source": "/api/auth/forgot-password",
      "destination": "/api/forgot-password"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/reset-password"
    },
    {
      "source": "/api/forgot-password",
      "destination": "/api/forgot-password"
    },
    {
      "source": "/api/reset-password",
      "destination": "/api/reset-password"
    },
    {
      "source": "/api/:match*",
