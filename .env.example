# Application Server Port
PORT=3000

# Backend Spring Boot Port
SERVER_PORT=8080

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/kaushalya_db

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-chars

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_MODE=test

# Frontend Configuration
VITE_API_BASE=http://localhost:8081
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Bootstrap Super Admin Credentials
ADMIN_EMAIL=admin@workshophub.edu
ADMIN_PASSWORD=YourSecurePassword123!

# Cloudinary Image Storage & CDN (Backend exclusive - never expose to client)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
