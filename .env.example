# ===================================================================
# Kaushalya (कौशल्य) — Environment Configuration Template
# ===================================================================

# Application Server Port
PORT=3000

# Backend Spring Boot Port
SERVER_PORT=8080

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_host>/kaushalya_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/kaushalya_db?retryWrites=true&w=majority

# JWT Signing Secret (HMAC SHA-256 key, minimum 256 bits)
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_length_here!!

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_MODE=test

# Frontend Configuration
VITE_API_BASE=http://localhost:8080
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Bootstrap Super Admin Credentials (used only if database is completely empty)
ADMIN_EMAIL=admin@workshophub.edu
ADMIN_PASSWORD=your_initial_admin_password_here
